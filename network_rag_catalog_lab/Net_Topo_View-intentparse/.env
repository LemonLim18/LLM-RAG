# ─────────────────────────────────────────────────────────
# CogniShield — Environment Variables (Lab Configuration)
# Host PC: 192.168.1.3 (development machine)
# ─────────────────────────────────────────────────────────

# ── Network Discovery (BFS Crawler) ──
# Core routers as BFS seeds — BFS discovers the rest via CDP/LLDP
CRAWL_SEEDS=192.168.1.40,192.168.1.41
CRAWL_USER=cognishield
CRAWL_PASSWORD=CogniShield@Lab2026
CRAWL_DRIVER=cisco_ios
CRAWL_WORKERS=6

# ── InfluxDB (VM: 192.168.1.250) ──
INFLUXDB_URL=http://192.168.1.250:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=netauto
INFLUXDB_BUCKET=telegraf

# ── OpenDaylight SDN Controller (VM: 192.168.1.250) ──
ODL_URL=http://192.168.1.250:8181
ODL_USERNAME=admin
ODL_PASSWORD=admin

# ── NetBox (VM: 192.168.1.252) ──
NETBOX_URL=https://192.168.1.252
NETBOX_TOKEN=a1c56312392af7ffcd83f0802dc45b1edda5196d
NETBOX_WEBHOOK_SECRET=cognishield-webhook-secret

# ── Prometheus (VM: 192.168.1.252) ──
PROMETHEUS_URL=http://192.168.1.252:9090

# ── Grafana (VM: 192.168.1.252) ──
GRAFANA_URL=http://192.168.1.252:3000

# ── Google Gemini LLM ──
GEMINI_API_KEY=

# ── Self-hosted LLM (default: Ollama + Qwen 2.5 Coder 3B) ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://192.168.1.251:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# ── Authentication ──
JWT_SECRET_KEY=change-me-in-production
DEFAULT_ADMIN_PASSWORD=admin

# ── SNMP (used by Telegraf on 192.168.1.250) ──
SNMP_COMMUNITY=cognishield

# ── EVE-NG (reference only — accessed via device SSH, not API) ──
EVENG_HOST=192.168.1.248
COGNISHIELD_MODE=local_lab
COGNISHIELD_OBSERVATION_PROVIDER=json_fixture
COGNISHIELD_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
COGNISHIELD_LOCAL_OLLAMA_MODEL=auto
COGNISHIELD_DB_PATH=db/m0_2_m0_3_browser_smoke.db

# Studio engine: v9 (published create_vlan slice) or original; applies to local_lab only.
COGNISHIELD_STUDIO_ENGINE=v9

# Existing bounded PDF extraction runtime; no inference-time installation.
COGNISHIELD_DOCUMENT_PYTHON=C:/Users/limmi/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe

COGNISHIELD_AI_ENGINE=langgraph_b3

COGNISHIELD_AI_PLANNING=1

COGNISHIELD_AI_SYNTHESIS=1
# Local draft authoring; active simulation requires explicit admin activation.
COGNISHIELD_DEV_WORKBENCH=1
