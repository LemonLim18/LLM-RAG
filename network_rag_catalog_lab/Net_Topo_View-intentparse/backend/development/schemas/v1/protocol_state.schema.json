                              "title": "Mtu Ignore"
                            },
                            "passive": {
                              "default": false,
                              "title": "Passive",
                              "type": "boolean"
                            },
                            "role": {
                              "default": "unknown",
                              "enum": [
                                "DR",
                                "BDR",
                                "DROther",
                                "point_to_point",
