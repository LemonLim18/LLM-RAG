                "title": "Depends On",
                "type": "array"
              },
              "values": {
                "type": "object",
                "if": {
                  "anyOf": [
                    {
                      "required": [
                        "left"
                      ]
                    },
                    {
                      "required": [
                        "right"
                      ]
                    }
                  ]
                },
                "then": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "left": {
                          "additionalProperties": false,
                          "properties": {
                            "device_id": {
                              "title": "Device Id",
                              "type": "integer"
                            },
                            "interface_id": {
                              "title": "Interface Id",
                              "type": "integer"
                            },
                            "router_id": {
                              "title": "Router Id",
                              "type": "string"
                            },
                            "area": {
                              "title": "Area",
                              "type": "string"
                            },
                            "process": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "default": null,
                              "title": "Process"
                            },
                            "area_type": {
                              "anyOf": [
                                {
                                  "enum": [
                                    "normal",
                                    "stub",
                                    "nssa"
                                  ],
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "default": null,
                              "title": "Area Type"
                            },
                            "hello_seconds": {
                              "exclusiveMinimum": 0,
                              "title": "Hello Seconds",
                              "type": "integer"
                            },
                            "dead_seconds": {
                              "exclusiveMinimum": 0,
                              "title": "Dead Seconds",
                              "type": "integer"
                            },
                            "network_type": {
                              "enum": [
                                "broadcast",
                                "point_to_point",
                                "non_broadcast"
                              ],
                              "title": "Network Type",
                              "type": "string"
                            },
                            "authentication": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "default": null,
                              "title": "Authentication"
                            },
                            "mtu": {
                              "anyOf": [
                                {
                                  "maximum": 65535,
                                  "minimum": 576,
                                  "type": "integer"
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "default": null,
                              "title": "Mtu"
