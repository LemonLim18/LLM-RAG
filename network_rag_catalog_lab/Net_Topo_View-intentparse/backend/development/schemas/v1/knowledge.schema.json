{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "category": {
      "const": "knowledge"
    },
    "status": {
      "default": "AVAILABLE",
      "enum": [
        "AVAILABLE",
        "MISSING",
        "UNAVAILABLE",
        "STALE",
        "ERROR",
        "CONFLICTING",
        "UNSUPPORTED",
        "NOT_QUERIED"
      ],
      "title": "Status",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_policy": {
          "const": "active_immutable_release"
        },
        "mutable": {
          "const": false
        },
        "query": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "category",
    "captured_at",
    "data"
  ],
  "title": "SourceFile",
  "type": "object"
}