{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "category": {
      "const": "source_health"
    },
    "status": {
      "default": "AVAILABLE",
      "enum": [
        "AVAILABLE",
        "MISSING",
        "UNAVAILABLE",
        "STALE",
        "ERROR",
        "CONFLICTING",
        "UNSUPPORTED",
        "NOT_QUERIED"
      ],
      "title": "Status",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Id",
                "type": "string"
              },
              "device_id": {
                "title": "Device Id",
                "type": "integer"
              },
              "interface_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Interface Id"
              },
              "timestamp": {
                "title": "Timestamp",
                "type": "string"
              },
              "kind": {
                "title": "Kind",
                "type": "string"
              },
              "source": {
                "title": "Source",
                "type": "string"
              },
              "current": {
                "default": true,
                "title": "Current",
                "type": "boolean"
              },
              "depends_on": {
                "items": {
                  "type": "string"
                },
                "maxItems": 30,
                "title": "Depends On",
                "type": "array"
              },
              "values": {
                "additionalProperties": true,
                "title": "Values",
                "type": "object"
              }
            },
            "required": [
              "id",
              "device_id",
              "timestamp",
              "kind",
              "source"
            ],
            "title": "Record",
            "type": "object"
          },
          "maxItems": 3000
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "status"
            ],
            "properties": {
              "category": {
                "enum": [
                  "inventory",
                  "topology_planned",
                  "topology_observed",
                  "topology_history",
                  "device_state",
                  "running_configs",
                  "config_snapshots",
                  "config_changes",
                  "routing_state",
                  "protocol_state",
                  "controller_state",
                  "telemetry",
                  "interface_metrics",
                  "syslog",
                  "incidents",
                  "config_drift",
                  "source_health",
                  "jobs_audit",
                  "knowledge",
                  "documents",
                  "attachments",
                  "diagrams",
                  "conversation",
                  "simulation"
                ]
              },
              "status": {
                "enum": [
                  "AVAILABLE",
                  "MISSING",
                  "UNAVAILABLE",
                  "STALE",
                  "ERROR",
                  "CONFLICTING",
                  "UNSUPPORTED",
                  "NOT_QUERIED"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "category",
    "captured_at",
    "data"
  ],
  "title": "SourceFile",
  "type": "object"
}