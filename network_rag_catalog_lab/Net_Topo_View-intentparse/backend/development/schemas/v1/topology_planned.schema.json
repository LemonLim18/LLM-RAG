{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "category": {
      "const": "topology_planned"
    },
    "status": {
      "default": "AVAILABLE",
      "enum": [
        "AVAILABLE",
        "MISSING",
        "UNAVAILABLE",
        "STALE",
        "ERROR",
        "CONFLICTING",
        "UNSUPPORTED",
        "NOT_QUERIED"
      ],
      "title": "Status",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "title": "Id",
                "type": "integer"
              },
              "src_device_id": {
                "title": "Src Device Id",
                "type": "integer"
              },
              "src_interface_id": {
                "title": "Src Interface Id",
                "type": "integer"
              },
              "dst_device_id": {
                "title": "Dst Device Id",
                "type": "integer"
              },
              "dst_interface_id": {
                "title": "Dst Interface Id",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "src_device_id",
              "src_interface_id",
              "dst_device_id",
              "dst_interface_id"
            ],
            "title": "Link",
            "type": "object"
          },
          "maxItems": 3000
        }
      }
    }
  },
  "required": [
    "category",
    "captured_at",
    "data"
  ],
  "title": "SourceFile",
  "type": "object"
}