set policy-options policy-statement {{ route_policy }} term EXPORT from protocol {{ "direct" if redistribution_source == "connected" else redistribution_source }}
set policy-options policy-statement {{ route_policy }} term EXPORT then metric {{ ospf_metric }}
set policy-options policy-statement {{ route_policy }} term EXPORT then external type {{ metric_type }}
set policy-options policy-statement {{ route_policy }} term EXPORT then accept
set protocols ospf export {{ route_policy }}
