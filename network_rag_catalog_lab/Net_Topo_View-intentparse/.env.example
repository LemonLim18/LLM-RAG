# M0: local GUI + SQLite; no remote adapters or scheduler are started.
# normal explicitly opts into the preserved integration stack and its dependencies.
COGNISHIELD_MODE=local_lab
# Optional: absolute SQLite path; relative paths resolve under backend/.
# COGNISHIELD_DB_PATH=C:/path/to/existing.db
# M0.1 local observation provider. It reads the editable JSON file below and
# validates every device/interface reference against the SQLite inventory.
COGNISHIELD_OBSERVATION_PROVIDER=json_fixture
# COGNISHIELD_FIXTURE_DIR=simulation
COGNISHIELD_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
COGNISHIELD_LOCAL_OLLAMA_MODEL=qwen2.5:1.5b
# The remote settings below are ignored by the local composition.

# ─────────────────────────────────────────────────────────
# CogniShield — Environment Variables
# Copy this file to .env and fill in your values.
#
# Lab Layout:
#   Host PC (CogniShield)     → 192.168.1.3
#   EVE-NG                    → 192.168.1.248
#   SDN + InfluxDB + Telegraf → 192.168.1.250
#   NetBox + Prometheus + Grafana → 192.168.1.252
# ─────────────────────────────────────────────────────────

# ── Network Discovery (BFS Crawler) ──
# Seed IPs = management IPs of devices to poll directly.
# Use "auto" for CRAWL_DRIVER to auto-detect vendor (Cisco/Huawei/Juniper).
# For partial lab, list only the running group's IPs.
CRAWL_SEEDS=192.168.1.42,192.168.1.43,192.168.1.46,192.168.1.47,192.168.1.48
CRAWL_USER=
CRAWL_PASSWORD=
CRAWL_DRIVER=auto
CRAWL_WORKERS=6

# ── InfluxDB (time-series telemetry) ──
INFLUXDB_URL=http://192.168.1.250:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=netauto
INFLUXDB_BUCKET=telegraf

# ── OpenDaylight SDN Controller ──
ODL_URL=http://192.168.1.250:8181
ODL_USERNAME=admin
ODL_PASSWORD=admin

# ── Prometheus (SNMP exporter metrics) ──
PROMETHEUS_URL=http://192.168.1.252:9090

# ── Grafana (visualization dashboards) ──
GRAFANA_URL=http://192.168.1.252:3000

# ── NetBox (network source of truth) ──
NETBOX_URL=http://192.168.1.252:8000
NETBOX_TOKEN=
NETBOX_WEBHOOK_SECRET=change-me

# ── Google Gemini LLM ──
GEMINI_API_KEY=

# ── LLM (default: local Ollama + Qwen 2.5 Coder 3B; set LLM_PROVIDER=gemini for cloud) ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://192.168.1.251:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# ── SNMP (community string matching device configs) ──
SNMP_COMMUNITY=cognishield

# Telegraf remote deployment (optional).
# When enabled, inventory changes can regenerate and deploy telegraf.conf
# to the Telegraf host, validate config, and restart service automatically.
TELEGRAF_REMOTE_AUTO_DEPLOY=false
TELEGRAF_REMOTE_HOST=192.168.1.250
TELEGRAF_REMOTE_PORT=22
TELEGRAF_REMOTE_USER=
TELEGRAF_REMOTE_PASSWORD=
# TELEGRAF_REMOTE_KEY_PATH=/home/user/.ssh/id_rsa
TELEGRAF_REMOTE_USE_SUDO=true
TELEGRAF_REMOTE_CONFIG_PATH=/etc/telegraf/telegraf.conf
TELEGRAF_REMOTE_TEST_CMD=telegraf --config /etc/telegraf/telegraf.conf --test
TELEGRAF_REMOTE_RESTART_CMD=systemctl restart telegraf
TELEGRAF_REMOTE_STATUS_CMD=systemctl is-active telegraf

# Syslog server inventory sync (optional).
# Keeps rsyslog dynamic fan-out + /etc/hosts in sync with onboarding inventory.
SYSLOG_REMOTE_AUTO_SYNC=false
SYSLOG_REMOTE_HOST=192.168.1.250
SYSLOG_REMOTE_PORT=22
SYSLOG_REMOTE_USER=
SYSLOG_REMOTE_PASSWORD=
SYSLOG_SERVER_CREDENTIAL_LABEL=ZTP_SERVER_SSH
# SYSLOG_SERVER_CREDENTIAL_DEVICE_ID=123
SYSLOG_DEVICE_PATH_MODE=hostname
SYSLOG_REMOTE_LOG_ROOT=/var/log/network-devices
SYSLOG_REMOTE_RULE_PATH=/etc/rsyslog.d/60-nettopoview-device-fanout.conf
SYSLOG_REMOTE_HOSTS_PATH=/etc/hosts
SYSLOG_REMOTE_VALIDATE_CMD=rsyslogd -N1
SYSLOG_REMOTE_RESTART_CMD=systemctl restart rsyslog
SYSLOG_REMOTE_FILE_OWNER=syslog
SYSLOG_REMOTE_FILE_GROUP=adm
SYSLOG_REMOTE_DIR_OWNER=syslog
SYSLOG_REMOTE_DIR_GROUP=adm
# Optional: forward mirrored syslog stream to NetTopoView backend listener
# so dashboard/security stream can refresh from live syslog events.
# If set, backend listens on this UDP port regardless of common-services profile.
BACKEND_SYSLOG_RECEIVER_PORT=6514
SYSLOG_FORWARD_APP_HOST=
SYSLOG_FORWARD_APP_PORT=6514

# ── Ansible Studio / plan-ansible performance ──
# ANSIBLE_PLAN_AGENT_FULL_CONTEXT=1   # optional: enable expensive build_full_context() for all LLM plans (default: off)
# ANSIBLE_PLAN_VECTOR_RAG=0           # optional: disable Chroma/embedding kb_snippets during plan-ansible (default: on)
# Intent policy gate (PolicyEngine): default off — set to 1/true to enforce policy_rules again
# ANSIBLE_INTENT_POLICY_VALIDATION=1

# ── Authentication ──
JWT_SECRET_KEY=change-me-in-production
DEFAULT_ADMIN_PASSWORD=admin

# Studio engine: v9 (published knowledge and reviewed operation/target bindings) or original; local_lab only.
COGNISHIELD_STUDIO_ENGINE=v9

# Optional: V9-managed knowledge workspace must be inside this CogniShield repository.
# COGNISHIELD_KNOWLEDGE_ROOT=C:/path/to/Net_Topo_View-intentparse/backend/knowledge_workspace

# Release-specific Chroma indexes use this installed Ollama embedding model.
COGNISHIELD_KNOWLEDGE_EMBED_MODEL=nomic-embed-text
# Optional document-only interpreter with pypdf already installed. Never installed during inference.
# COGNISHIELD_DOCUMENT_PYTHON=C:/path/to/python.exe
# WSL remains disabled for untrusted validation until a pinned profile and containment self-test pass.
# COGNISHIELD_WSL_DISTRO=Ubuntu-22.04
# COGNISHIELD_WSL_VALIDATION_PROFILE=/opt/cognishield-validator/reviewed-profile

# Optional read-only access to the configured collector. Never starts collection or devices.
COGNISHIELD_AI_LIVE_READS=0

# Shared document understanding (installed local tools only; no automatic downloads).
# Windows.Media.Ocr is the default. PDF rasterization requires Poppler pdftoppm.
# COGNISHIELD_PDF_RENDERER=C:/path/to/pdftoppm.exe
# Optional OCR-only model, never used for chat or diagram reasoning. 30s/page, 90s/job.
# COGNISHIELD_OCR_MODEL=maternion/LightOnOCR-2:1b
# Optional general vision model must advertise vision; OCR-only models are excluded.
# COGNISHIELD_VISION_MODEL=your-installed-vision-chat-model
COGNISHIELD_SEMANTIC_EMBEDDINGS=1
COGNISHIELD_ROUTING_EMBED_MODEL=nomic-embed-text:latest

# Shared local Floating/Studio orchestration: langgraph_b3; langgraph_b2, langgraph_b1 or legacy for rollback.
# Requires requirements-agent-b1.lock.txt; no inference-time installation.
COGNISHIELD_AI_ENGINE=langgraph_b3
# Shared model planning and grounded synthesis enabled. Set either to 0 for rollback.
# They reuse the same graph, authorized readers and Ollama model registry.
COGNISHIELD_AI_PLANNING=1
COGNISHIELD_AI_SYNTHESIS=1

# Explicit development network authority. Local-lab only; never a production fallback.
COGNISHIELD_DEV_SIMULATION=0
# COGNISHIELD_DEV_STATE=tmp/development-network/state.json

# Experimental hybrid is OFF. A server-approved exact synthetic request/history
# plus exact authenticated owner consent and allowed source provenance are required; client flags cannot grant access.
COGNISHIELD_AI_HYBRID=0
GEMINI_MODEL=gemini-3.5-flash-lite
COGNISHIELD_AI_HYBRID_SECONDS=120
COGNISHIELD_AI_HYBRID_CALLS=1
COGNISHIELD_AI_HYBRID_INTERPRET=0
COGNISHIELD_AI_OUTCOMES=0
COGNISHIELD_AI_HYBRID_THINKING=low
COGNISHIELD_AI_HYBRID_OUTPUT_TOKENS=8192
COGNISHIELD_AI_HYBRID_RPM=15
COGNISHIELD_AI_HYBRID_INPUT_TPM=150000
COGNISHIELD_AI_HYBRID_RPD=500
COGNISHIELD_AI_HYBRID_SCENARIOS=
COGNISHIELD_AI_COMPLEX_PLANNER_PROVIDER=google
COGNISHIELD_AI_COMPLEX_PLANNER_MODEL=gemini-3.1-flash-lite
COGNISHIELD_AI_REASONER_PROVIDER=google
COGNISHIELD_AI_REASONER_MODEL=gemini-3.5-flash-lite
COGNISHIELD_AI_MULTI_MODEL_EXPERIMENT=0
COGNISHIELD_AI_EVIDENCE_REFINE=1
COGNISHIELD_AI_EXPERIMENT_SEMANTIC_VERIFIER=off
COGNISHIELD_AI_MULTI_MODEL_CALLS=3
COGNISHIELD_AI_COMPLEX_PLANNER_SCHEMA_MODE=validated_json
COGNISHIELD_AI_REASONER_SCHEMA_MODE=validated_json
# Optional evidence metadata, still requiring exact synthetic owner consent.
COGNISHIELD_AI_EVIDENCE_HARNESS=0
COGNISHIELD_AI_HARNESS_LEDGER=1
COGNISHIELD_AI_HARNESS_GUIDANCE=1
COGNISHIELD_AI_HARNESS_PROVENANCE=1

# Completeness-first investigation is separately consented, synthetic-only.
COGNISHIELD_AI_COMPLETENESS=0
COGNISHIELD_AI_INVESTIGATION_SECONDS=360
COGNISHIELD_AI_INVESTIGATION_PLANNER_SECONDS=90
COGNISHIELD_AI_INVESTIGATION_REASONER_SECONDS=120
COGNISHIELD_AI_INVESTIGATION_INITIAL_READ_SECONDS=90
COGNISHIELD_AI_INVESTIGATION_SUPPLEMENT_READ_SECONDS=60
COGNISHIELD_AI_INVESTIGATION_ADEQUACY_SECONDS=5
COGNISHIELD_AI_INVESTIGATION_MAX_READERS=24
COGNISHIELD_AI_INVESTIGATION_MAX_ROUNDS=3
COGNISHIELD_AI_INVESTIGATION_MAX_ROLE_CALLS=5
