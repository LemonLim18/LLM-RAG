{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interface": {
      "minLength": 1,
      "type": "string"
    },
    "address": {
      "format": "ipv4",
      "type": "string"
    },
    "prefix_length": {
      "minimum": 0,
      "maximum": 32,
      "type": "integer"
    }
  },
  "required": [
    "interface",
    "address",
    "prefix_length"
  ]
}
