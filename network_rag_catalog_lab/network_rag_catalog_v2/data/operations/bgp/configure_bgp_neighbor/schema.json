{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "local_as",
    "neighbor_ip",
    "remote_as"
  ],
  "properties": {
    "local_as": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "neighbor_ip": {
      "type": "string"
    },
    "remote_as": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "description": {
      "type": "string",
      "maxLength": 128
    }
  }
}