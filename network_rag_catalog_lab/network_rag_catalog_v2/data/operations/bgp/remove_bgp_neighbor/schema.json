{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["local_as", "neighbor_ip", "remote_as"],
  "x-required-by-vendor": {
    "juniper": ["peer_group"]
  },
  "properties": {
    "local_as": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "neighbor_ip": {"type": "string", "format": "ipv4"},
    "remote_as": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "peer_group": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
