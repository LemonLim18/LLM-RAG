{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "vlan_id": {
      "minimum": 2,
      "maximum": 1001,
      "type": "integer"
    },
    "vlan_status": {
      "enum": [
        "active",
        "suspend"
      ],
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9 _./:()-]+$",
      "type": "string"
    },
    "current_vlan_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
      "description": "Exact existing Junos VLAN object name for the selected VLAN ID."
    }
  },
  "required": [
    "vlan_id",
    "vlan_status"
  ],
