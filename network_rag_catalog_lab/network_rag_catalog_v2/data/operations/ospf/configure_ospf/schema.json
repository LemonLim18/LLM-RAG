{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["interfaces"],
  "x-required-by-vendor": {
    "cisco": ["process_id"],
    "huawei": ["process_id"]
  },
  "properties": {
    "process_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "router_id": {
      "type": "string",
      "format": "ipv4"
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "area"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string"
          }
        }
      }
    }
  }
}
