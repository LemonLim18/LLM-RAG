{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-required-by-vendor": {
    "cisco": [
      "process_id"
    ],
    "huawei": [
      "process_id"
    ]
  },
  "properties": {
    "process_id": {
      "minimum": 1,
      "maximum": 65535,
      "type": "integer"
    },
    "router_id": {
      "format": "ipv4",
      "type": "string"
    },
    "interfaces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "x-parameter-id": "interface",
            "minLength": 1,
            "type": "string"
          },
          "area": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "area"
        ]
      }
    }
  },
  "required": [
    "interfaces"
  ]
}
